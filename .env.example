# Copy this file to .env and fill in ONE of the two Amazon options. Never share or upload your .env file.

# Option 1 – RapidAPI "Real-Time Amazon Data" (free tier). Subscribe at
# https://rapidapi.com  → search "Real-Time Amazon Data" → copy your X-RapidAPI-Key
RAPIDAPI_KEY=

# Option 2 – Official Amazon Product Advertising API 5.0 (needs an approved Amazon Associates account on amazon.in)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Optional
# AMAZON_PROVIDER=rapidapi        # or paapi – only needed if you filled in both options
# AMAZON_MAX_PER_SEARCH=10        # products imported per search
# AMAZON_REFRESH_MINUTES=0        # refresh Amazon prices automatically while the app runs (0 = off).
#                                 # Each RapidAPI refresh uses 1 request per saved search – watch your monthly quota.
# ANTHROPIC_API_KEY=              # powers GlowBot with Claude
